{
    "name": "kallijaguar/inventory",
    "description": "Sistema de Gestión de Inventario Kalli Jaguar",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=7.4",
        "vlucas/phpdotenv": "^5.6",
        "phpmailer/phpmailer": "^6.9",
        "setasign/fpdf": "^1.8"
    },
    "_comment_env": "vlucas/phpdotenv es opcional: config.php incluye un cargador built-in como fallback para hosting compartido sin acceso a CLI.",
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "KalliJaguar\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KalliJaguar\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
