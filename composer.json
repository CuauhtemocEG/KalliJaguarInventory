{
    "name": "kallijaguar/inventory",
    "description": "KalliJaguarInventory - Sistema de gestión de inventario",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-mbstring": "*",
        "vlucas/phpdotenv": "^5.6",
        "phpmailer/phpmailer": "^6.9",
        "setasign/fpdf": "^1.8",
        "picqer/php-barcode-generator": "^3.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/Helpers/functions.php"
        ]
    },
    "scripts": {
        "test": "php tests/run.php",
        "migrate": "php database/migrate.php",
        "seed": "php database/seed.php"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
