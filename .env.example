# ============================================================
# KALLI JAGUAR INVENTORY - Variables de Entorno
# ============================================================
# Copiar este archivo como .env y rellenar los valores reales.
# El archivo .env NUNCA debe subirse al repositorio.
# ============================================================

# Entorno de la aplicación
APP_ENV=production
APP_DEBUG=false

# Base de datos
DB_HOST=localhost:3306
DB_NAME=kallijag_inventory
DB_USER=kallijag_admin
DB_PASS=

# Sesión
SESSION_NAME=KALLI_SESSION
SESSION_LIFETIME=7200
