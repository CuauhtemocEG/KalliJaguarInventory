# ============================================================
# KalliJaguarInventory - Variables de entorno (plantilla)
# Copie este archivo a ".env" y ajuste los valores.
# NUNCA suba el archivo ".env" al repositorio.
# ============================================================

# ---- Aplicación ----
APP_NAME="Kalli Inventory System"
APP_SHORT_NAME="Kalli Jaguar"
APP_VERSION=2.1.8
APP_BUILD=20250415
APP_RELEASE_DATE="9 de diciembre de 2025"
APP_COMPANY="Kalli Jaguar"
APP_DEVELOPER="Kalli Development Team"
APP_YEAR=2025
# production | development | staging
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=America/Mexico_City
APP_LOCALE=es-MX
# Tasa de IVA aplicada a los precios (0.16 = 16%)
TAX_RATE=0.16
# URL pública base (sin barra final). Ej: https://inventario.midominio.com o http://localhost:8000
APP_URL=http://localhost:8888

# ---- Versiones de módulos ----
MODULE_PRODUCTS=2.0
MODULE_CATEGORIES=2.0
MODULE_TAGS=2.0
MODULE_ORDERS=1.0
MODULE_USERS=2.0

# ---- Base de datos ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=kallijag_inventory
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4

# ---- Correo (SMTP) ----
MAIL_HOST=smtp.example.com
MAIL_PORT=465
# ssl | tls | (vacío)
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=info@example.com
MAIL_FROM_NAME="Informacion Kalli Jaguar"
# Destinatario principal de las notificaciones de comandas
MAIL_TO=
# Copias (separadas por coma)
MAIL_CC=

# ---- Sesión y seguridad ----
SESSION_NAME=INV
SESSION_LIFETIME=2592000
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_TIME=900

# ---- API / paginación ----
API_VERSION=v1
API_TIMEOUT=30
API_MAX_REQUESTS=100
PAGINATION_DEFAULT_LIMIT=20
PAGINATION_MAX_LIMIT=100

# ---- Rutas y archivos (relativas a la raíz del proyecto) ----
UPLOADS_DIR=public/assets/img
UPLOADS_PRODUCTS_DIR=producto
UPLOAD_MAX_SIZE_MB=2
LOGS_DIR=storage/logs
DOCUMENTS_DIR=storage/documents
FONTS_DIR=storage/fonts

# Desactiva ONLY_FULL_GROUP_BY en la sesión (las consultas heredadas lo requieren hasta portarlas al esquema nuevo)
DB_LEGACY_GROUP_BY=true

# ---- Rediseño de BD (scripts de database/) ----
# Base de datos con el esquema NUEVO (migrate.php / seed.php). Si se deja vacía se usa DB_NAME.
DB_NAME_NEW=
# Base de datos con el esquema ANTERIOR (origen de database/migrate_legacy.php; mismo servidor/usuario)
LEGACY_DB_NAME=

# ---- Usuario administrador inicial (solo para database/seed.php) ----
ADMIN_NAME="Administrador"
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
# Defina una contraseña robusta (mín. 10 caracteres); se almacena con password_hash
ADMIN_PASSWORD=
